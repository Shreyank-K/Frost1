{
  "name": "frost-plain-expo-refined",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:sim": "eas build --platform ios --profile development-simulator",
    "run:ios:sim": "eas build:run --platform ios --profile development-simulator",
    "run:ios:device": "expo run:ios --device",
    "run:ios:local-sim": "expo run:ios --simulator",
    "devices:ios": "eas device:create",
    "devices:ios:list": "eas device:list --apple-team-id 29884LQZ4R",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "supabase:start": "npx supabase start",
    "supabase:db:push": "npx supabase db push",
    "supabase:functions:serve": "npx supabase functions serve --env-file supabase/functions/.env"
  },
  "dependencies": {
    "@expo/vector-icons": "~15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.104.0",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "supabase": "^2.93.1",
    "typescript": "~5.9.2"
  }
}
